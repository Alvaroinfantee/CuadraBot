[Unit]
Description=CuadraBot allowlisted OpenAI egress proxy
After=network-online.target user@@@EXECUTOR_UID@@.service
Wants=network-online.target
Requires=user@@@EXECUTOR_UID@@.service
RequiresMountsFor=@@CUADRABOT_ROOT@@

[Service]
Type=simple
User=@@EXECUTOR_USER@@
Group=@@EXECUTOR_USER@@
Environment=HOME=@@EXECUTOR_HOME@@
Environment=XDG_RUNTIME_DIR=/run/user/@@EXECUTOR_UID@@
Environment=EGRESS_ENV_FILE=/run/cuadrabot-executor/egress.env
EnvironmentFile=@@CUADRABOT_ROOT@@/secrets/host.env
RuntimeDirectory=cuadrabot-executor
RuntimeDirectoryMode=0700
ExecStartPre=+@@CUADRABOT_LIBEXEC@@/preflight-component.sh egress
ExecStartPre=+@@CUADRABOT_LIBEXEC@@/stage-egress-env.sh
ExecStart=@@CUADRABOT_LIBEXEC@@/run-egress.sh
ExecStop=@@CUADRABOT_LIBEXEC@@/stop-egress.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
InaccessiblePaths=@@CUADRABOT_ROOT@@/worker-jobs
ReadWritePaths=/run/cuadrabot-executor /run/user/@@EXECUTOR_UID@@
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
