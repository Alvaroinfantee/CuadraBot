# Optional off-host Restic target. Restic encrypts data before upload.
RESTIC_REPOSITORY=s3:https://lon1.digitaloceanspaces.com/replace-bucket/cuadrabot-executor
RESTIC_PASSWORD=replace-with-a-long-independent-restic-password
AWS_ACCESS_KEY_ID=replace-with-scoped-spaces-access-key
AWS_SECRET_ACCESS_KEY=replace-with-scoped-spaces-secret-key
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=3
