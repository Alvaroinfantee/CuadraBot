# This file contains no secret token. Authenticate doctl using a named context.
# The scripts source this file as shell syntax. Keep the complete SSH public key
# inside single quotes so its required spaces cannot be parsed as a command.
DOCTL_CONTEXT=default
DO_PROJECT_ID=
DO_VPC_UUID=
DO_SSH_KEY_FINGERPRINT=replace-with-digitalocean-ssh-key-fingerprint
ADMIN_SSH_PUBLIC_KEY='ssh-ed25519 replace-with-public-key-only'
ADMIN_SSH_CIDR=203.0.113.10/32

DROPLET_NAME=cuadrabot-executor-prod-1
DROPLET_REGION=lon1
DROPLET_SIZE=s-8vcpu-16gb
DROPLET_IMAGE=ubuntu-24-04-x64
DROPLET_TAG=cuadrabot-executor
FIREWALL_NAME=cuadrabot-executor-ssh-only
VOLUME_NAME=cuadrabot-prod
VOLUME_SIZE=100GiB
VOLUME_FS_LABEL=cuadrabot-prod

# Required only for --apply. This prevents accidental production creation.
CONFIRM_PRODUCTION_CREATE=
