CUADRABOT_API_URL=https://cuadrabot.com
WORKER_SHARED_SECRET=replace-with-the-identical-web-application-worker-secret
WORKER_ID=takeoff-worker-prod-1

# The worker talks only to the loopback broker. It never receives OPENAI_API_KEY.
TAKEOFF_SERVICE_URL=http://127.0.0.1:8090
TAKEOFF_SERVICE_API_TOKEN=replace-with-the-broker-token
TAKEOFF_CODEX_MODEL=gpt-5.6-sol

LOCAL_JOBS_DIR=/srv/cuadrabot/worker-jobs
POLL_INTERVAL_MS=30000
TAKEOFF_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=60000
TAKEOFF_JOB_TIMEOUT_MS=26100000
WORKER_API_TIMEOUT_MS=60000
ARTIFACT_UPLOAD_TIMEOUT_MS=600000
WORKER_MAX_FILE_BYTES=262144000
KEEP_LOCAL_JOB_FILES=false
