# Source this file only after replacing each placeholder. Keep it outside the
# repository once populated because shell environment files are executable
# configuration.
CUADRABOT_HOST_PROFILE=budget
DOCTL_CONTEXT=default
DO_SSH_KEY_FINGERPRINT=replace-with-digitalocean-fingerprint
ADMIN_SSH_PUBLIC_KEY='ssh-ed25519 replace-with-public-key-only'
ADMIN_SSH_CIDR=203.0.113.10/32

DROPLET_NAME=cuadrabot-executor-budget-1
DROPLET_REGION=lon1
DROPLET_SIZE=s-1vcpu-2gb
DROPLET_IMAGE=ubuntu-24-04-x64
DROPLET_TAG=cuadrabot-executor-budget
FIREWALL_NAME=cuadrabot-executor-budget-ssh-only
VOLUME_NAME=cuadrabot-bgt
VOLUME_SIZE=10GiB
VOLUME_FS_LABEL=cuadrabot-bgt

# Optional: copy from the existing resources after verifying them in the
# DigitalOcean control plane.
DO_PROJECT_ID=
DO_VPC_UUID=

CONFIRM_PRODUCTION_CREATE=cuadrabot-executor-lon1
