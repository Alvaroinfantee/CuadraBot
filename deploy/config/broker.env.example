# Must match TAKEOFF_SERVICE_API_TOKEN in worker.env.
EXECUTOR_BROKER_TOKEN=replace-with-a-random-32-byte-or-longer-token

# Independent keys. Do not reuse the worker, broker, cron, or egress token.
EXECUTOR_EGRESS_CONTROL_TOKEN=replace-with-an-independent-random-token
EXECUTOR_PROCESSOR_KEY_SECRET=replace-with-an-independent-random-hmac-key
EXECUTOR_SAFETY_SECRET=replace-with-an-independent-random-hmac-key
