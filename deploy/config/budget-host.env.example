# Low-volume production profile for a 1 vCPU / 2 GiB RAM Droplet. It retains
# the same identity, secret, network, image-pinning, and disposable-container
# boundaries as the standard profile, but accepts only one resource-constrained
# takeoff at a time. Large or unusually dense drawing sets can exhaust this
# profile and should be retried on the standard host profile.
CUADRABOT_ROOT=/srv/cuadrabot
CUADRABOT_RELEASE=/srv/cuadrabot/current
CUADRABOT_DEPLOY_USER=cuadrabot
CUADRABOT_DEPLOY_UID=10001
CUADRABOT_DEPLOY_HOME=/home/cuadrabot
CUADRABOT_EXECUTOR_USER=cuadraexec
CUADRABOT_EXECUTOR_UID=10002
CUADRABOT_EXECUTOR_HOME=/home/cuadraexec
CUADRABOT_WORKER_USER=cuadraworker
CUADRABOT_WORKER_UID=10003
CUADRABOT_CRON_USER=cuadracron
CUADRABOT_CRON_UID=10004
CUADRABOT_LIBEXEC=/usr/local/lib/cuadrabot
CUADRABOT_HOST_PROFILE=budget
NODE_BIN=/usr/local/bin/node
NPM_BIN=/usr/local/bin/npm
DOCKER_HOST=unix:///run/user/10002/docker.sock
DOCKER_CONFIG=/srv/cuadrabot/executor/docker-config

# A small encrypted Block Storage volume keeps runtime secrets and disposable
# state off the Droplet boot disk without recreating the old 100 GiB expense.
CUADRABOT_VOLUME_DEVICE=/dev/disk/by-id/scsi-0DO_Volume_cuadrabot-bgt
CUADRABOT_VOLUME_LABEL=cuadrabot-bgt
DO_VOLUME_ENCRYPTION_AT_REST_CONFIRMED=false
ADMIN_SSH_CIDR=203.0.113.10/32
DO_CLOUD_FIREWALL_SSH_ONLY_CONFIRMED=false

REPOSITORY_URL=https://github.com/Alvaroinfantee/CuadraBot.git
EXECUTOR_IMAGE=ghcr.io/alvaroinfantee/cuadrabot-executor@sha256:replace-with-64-hex-digest
EXECUTOR_PROCESSOR_IMAGE=ghcr.io/alvaroinfantee/cuadrabot-takeoff@sha256:replace-with-64-hex-digest

EXECUTOR_BROKER_HOST=127.0.0.1
EXECUTOR_BROKER_PORT=8090
EXECUTOR_EGRESS_CONTAINER=cuadrabot-openai-egress
EXECUTOR_EGRESS_NETWORK=cuadrabot-egress
EXECUTOR_EGRESS_STATE_VOLUME=cuadrabot-egress-state
EXECUTOR_EGRESS_CONTROL_URL=http://127.0.0.1:8092
EXECUTOR_EGRESS_MEMORY=256m
EXECUTOR_EGRESS_MEMORY_SWAP=256m
EXECUTOR_EGRESS_CPUS=0.25
EXECUTOR_EGRESS_PIDS=96
EGRESS_STATE_DIR=/state
EGRESS_DATA_HOST=0.0.0.0
EGRESS_DATA_PORT=8091
EGRESS_CONTROL_HOST=0.0.0.0
EGRESS_CONTROL_PORT=8092

EXECUTOR_STATE_DIR=/srv/cuadrabot/executor/state
EXECUTOR_PROCESSOR_MEMORY=1g
EXECUTOR_PROCESSOR_MEMORY_SWAP=1g
EXECUTOR_PROCESSOR_CPUS=1
EXECUTOR_PROCESSOR_PIDS=128
EXECUTOR_PROCESSOR_TMPFS=128m
EXECUTOR_MAX_CONCURRENT_JOBS=1
EXECUTOR_JOB_TTL_SECONDS=28800
EXECUTOR_DOCKER_BIN=/usr/bin/docker
EXECUTOR_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
