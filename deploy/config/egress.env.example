# This is the only host file that contains the master OpenAI Platform key.
OPENAI_API_KEY=replace-with-server-owned-openai-platform-key

# Must match EXECUTOR_EGRESS_CONTROL_TOKEN in broker.env.
EGRESS_CONTROL_TOKEN=replace-with-an-independent-random-token
EGRESS_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
