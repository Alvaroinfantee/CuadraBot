# Public application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENABLE_DEMO_MODE=true
DEFAULT_CURRENCY=usd
MAX_UPLOAD_MB=100
MAX_PLAN_PAGES=250
# Stable base64 AES key for multi-instance Server Actions (32 decoded bytes recommended)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Supabase (preferred current key names)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase keys are supported through the 2026 transition if required:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Private Storage buckets created by the migration
TAKEOFF_UPLOAD_BUCKET=takeoff-uploads
TAKEOFF_RESULT_BUCKET=takeoff-results

# Stripe server keys and signed webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRICE_CREDITS_550=
STRIPE_PRICE_CREDITS_1800=
STRIPE_PRICE_CREDITS_5000=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_OFFICE_MONTHLY=

# Internal service authentication
WORKER_SHARED_SECRET=
CRON_SECRET=
# Independent 32+ character HMAC key for keyed IP rate-limit buckets
RATE_LIMIT_SECRET=

# Operational contact
ADMIN_EMAIL=
OWNER_REQUEST_EMAIL=support@cuadrabot.com
