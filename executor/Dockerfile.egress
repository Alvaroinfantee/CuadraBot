FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2

ENV NODE_ENV=production \
    EGRESS_STATE_DIR=/state \
    EGRESS_DATA_HOST=0.0.0.0 \
    EGRESS_DATA_PORT=8091 \
    EGRESS_CONTROL_HOST=0.0.0.0 \
    EGRESS_CONTROL_PORT=8092

WORKDIR /app
COPY --chown=node:node executor/src ./executor/src
RUN mkdir -p /state && chown node:node /state

VOLUME ["/state"]
USER node
EXPOSE 8091 8092
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8092/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "executor/src/egress-main.mjs"]
