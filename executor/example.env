# Egress proxy (inside the non-root proxy container)
OPENAI_API_KEY=
EGRESS_CONTROL_TOKEN=
EGRESS_STATE_DIR=/state
EGRESS_DATA_HOST=0.0.0.0
EGRESS_DATA_PORT=8091
EGRESS_CONTROL_HOST=0.0.0.0
EGRESS_CONTROL_PORT=8092
EGRESS_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
EGRESS_MAX_REQUEST_BYTES=16777216
EGRESS_MAX_RESPONSE_BYTES=16777216
EGRESS_MAX_DATA_IMAGE_BYTES=11534336
EGRESS_MAX_DATA_IMAGES_PER_REQUEST=8
EGRESS_MAX_IN_FLIGHT_REQUESTS=1
# Defense-in-depth ceilings; trusted per-tier USD limits are lower/authoritative.
EGRESS_MAX_REQUEST_BYTES_PER_TOKEN=2147483648
EGRESS_MAX_OUTPUT_TOKENS_PER_REQUEST=32000
EGRESS_MAX_OUTPUT_TOKENS_PER_TOKEN=1000000
EGRESS_MAX_REQUESTS_PER_TOKEN=512
EGRESS_MAX_TOKEN_TTL_SECONDS=28800

# Host-native broker
EXECUTOR_BROKER_HOST=127.0.0.1
EXECUTOR_BROKER_PORT=8090
EXECUTOR_BROKER_TOKEN=
EXECUTOR_STATE_DIR=/var/lib/cuadrabot-executor
EXECUTOR_EGRESS_CONTROL_URL=http://127.0.0.1:8092
EXECUTOR_EGRESS_CONTROL_TOKEN=
EXECUTOR_EGRESS_CONTAINER=cuadrabot-openai-egress
EXECUTOR_PROCESSOR_KEY_SECRET=
EXECUTOR_SAFETY_SECRET=
EXECUTOR_PROCESSOR_IMAGE=
EXECUTOR_PROCESSOR_MEMORY=6g
EXECUTOR_PROCESSOR_MEMORY_SWAP=6g
EXECUTOR_PROCESSOR_CPUS=2
EXECUTOR_PROCESSOR_PIDS=256
EXECUTOR_PROCESSOR_TMPFS=512m
EXECUTOR_MAX_CONCURRENT_JOBS=1
EXECUTOR_JOB_TTL_SECONDS=28800
